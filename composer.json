{
  "name": "presprog/kirby-seo-plugin",
  "description": "Opinionated SEO plugin for Kirby CMS. With meta description, open graph, sitemap and robots.txt",
  "type": "kirby-plugin",
  "license": "MIT",
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
    "getkirby/cms": "^6.0",
    "getkirby/composer-installer": "^1.2"
  },
  "autoload": {
      "psr-4": {
          "PresProg\\KirbyMeta\\": "classes/"
      }
  },
  "extra": {
    "installer-name": "seo",
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
